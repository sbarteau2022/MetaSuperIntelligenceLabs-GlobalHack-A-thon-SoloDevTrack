{
  "name": "atoma-labs-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "audit:headers": "node scripts/audit-headers.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "stamp:version": "node scripts/stamp-version.mjs",
    "verify": "npm run gate && npm run typecheck && npm run lint && npm run build && npm run stamp:version && npm run audit:headers && npm run audit:bundle",
    "gate": "bash scripts/verify/gate.sh"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.187.0",
    "@xyflow/react": "^12.11.6",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
